#!/bin/bash
#SBATCH --job-name=cc_ccacts_{{run_id}}
#SBATCH --output={{log_dir}}/{{run_id}}_03_ccacts_%j.out
#SBATCH --error={{log_dir}}/{{run_id}}_03_ccacts_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={{cpus_per_task}}
#SBATCH --gres={{gres_gpu}}
#SBATCH --mem={{mem}}
#SBATCH --partition={{partition}}

set -euo pipefail
exec > >(tee -a "{{run_log}}") 2>&1
sleep 0.1  # wait for tee process to start (avoids race with set -euo pipefail)
source {{venv}}
source {{env_file}} 2>/dev/null || true
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

trap 'echo "ERROR: Job $SLURM_JOB_ID ({{run_id}} step 03) failed at line $LINENO — downstream jobs will not run" >&2' ERR

echo "Job: $SLURM_JOB_ID  Node: $SLURMD_NODENAME  $(date)"
echo "Run: {{run_id}}"
echo "Step 03: Collect CrossCoder activations (test split — for freq analysis)"

mkdir -p "$(dirname "{{cc_acts_meta}}")"
OUT_DIR="$(dirname "{{cc_acts_meta}}")"

python -u "{{scripts_dir}}/03_collect_crosscoder_acts/collect_crosscoder_acts.py" \
    --model-base  "{{model_a}}" \
    --model-cpt   "{{model_b}}" \
    --crosscoder  "{{cc_checkpoint}}" \
    --dataset     "{{dataset}}" \
    --split       test \
    --layer       {{layer_a}} \
    --batch       4 \
    --max-len     2048 \
    --out-dir     "$OUT_DIR"

# The script writes <name>_meta.pt; find the most recent and symlink
LATEST_META=$(ls -t "$OUT_DIR"/*_meta.pt 2>/dev/null | head -1)
if [ -n "$LATEST_META" ] && [ "$LATEST_META" != "{{cc_acts_meta}}" ]; then
    ln -sf "$LATEST_META" "{{cc_acts_meta}}"
    echo "Symlinked $LATEST_META -> {{cc_acts_meta}}"
fi

echo "Done: $(date)"
echo "Meta: {{cc_acts_meta}}"
